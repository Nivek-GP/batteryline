<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de pantalla: degradado vertical gris-negro con un brillo radial sutil arriba. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#FF0A0A0A"
                android:endColor="#FF000000"
                android:startColor="#FF1C1C1C" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.85"
                android:centerY="0.0"
                android:endColor="#00FFFFFF"
                android:gradientRadius="700"
                android:startColor="#1FFFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

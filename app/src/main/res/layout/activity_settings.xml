<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Dap.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Dap.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subtitle" />

        <!-- Solo visible mientras falte el permiso de overlay. -->
        <LinearLayout
            android:id="@+id/permissionCard"
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                style="@style/Dap.Text.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_title" />

            <TextView
                style="@style/Dap.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/permission_body" />

            <Button
                android:id="@+id/grantButton"
                style="@style/Dap.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/permission_button" />
        </LinearLayout>

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/enabledSwitch"
                style="@style/Dap.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enabled_switch" />

            <TextView
                android:id="@+id/batteryStatus"
                style="@style/Dap.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />
        </LinearLayout>

        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_line" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/thickness"
                layout="@layout/view_slider" />

            <include
                android:id="@+id/offset"
                layout="@layout/view_slider" />

            <include
                android:id="@+id/opacity"
                layout="@layout/view_slider" />

            <TextView
                style="@style/Dap.Text.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/anchor_label" />

            <TextView
                style="@style/Dap.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/anchor_caption" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/anchorGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/anchorLeft"
                    style="@style/Dap.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/anchor_left" />

                <Button
                    android:id="@+id/anchorCenter"
                    style="@style/Dap.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/anchor_center" />

                <Button
                    android:id="@+id/anchorRight"
                    style="@style/Dap.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/anchor_right" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_battery" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/fullAt"
                layout="@layout/view_slider" />

            <TextView
                style="@style/Dap.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/full_at_caption" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/lowSwitch"
                style="@style/Dap.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/low_switch" />

            <include
                android:id="@+id/lowThreshold"
                layout="@layout/view_slider" />
        </LinearLayout>

        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_edges" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Dap.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edges_caption" />

            <include
                android:id="@+id/marginLeft"
                layout="@layout/view_slider" />

            <include
                android:id="@+id/marginRight"
                layout="@layout/view_slider" />

            <Button
                android:id="@+id/autoButton"
                style="@style/Dap.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/edges_auto" />
        </LinearLayout>

        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_preview" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/previewSwitch"
                style="@style/Dap.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_switch" />

            <include
                android:id="@+id/previewLevel"
                layout="@layout/view_slider" />

            <TextView
                style="@style/Dap.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_caption" />
        </LinearLayout>

        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_system" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bootSwitch"
                style="@style/Dap.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boot_switch" />
        </LinearLayout>

        <!-- Optimización de batería: algunas ROMs cierran servicios aunque estén en primer plano. -->
        <LinearLayout
            android:id="@+id/batteryOptRow"
            style="@style/Dap.Card.Clickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Dap.Text.Item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_opt_title" />

                <TextView
                    android:id="@+id/batteryOptStatus"
                    style="@style/Dap.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dap_ic_chevron" />
        </LinearLayout>

        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_tile" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Dap.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_body" />

            <Button
                android:id="@+id/addTileButton"
                style="@style/Dap.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/tile_add" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
